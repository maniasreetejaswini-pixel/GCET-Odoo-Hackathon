<!DOCTYPE html><html><head><title>StockSense - Dashboard</title><link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'></head><body><%- include('partials/header') %><h2>Dashboard View</h2><div class='row text-center my-4'><div class='col'><div class='card p-3 bg-light'><h5>Total Products</h5><h3><%= totalProducts %></h3></div></div><div class='col'><div class='card p-3 bg-warning text-dark'><h5>Low / Out of Stock</h5><h3><%= lowStock %></h3></div></div><div class='col'><div class='card p-3 bg-info text-white'><h5>Pending Receipts</h5><h3><%= pendingReceipts %></h3></div></div><div class='col'><div class='card p-3 bg-danger text-white'><h5>Pending Deliveries</h5><h3><%= pendingDeliveries %></h3></div></div><div class='col'><div class='card p-3 bg-secondary text-white'><h5>Internal Transfers</h5><h3><%= internalTransfers %></h3></div></div></div><h3>Move History Log</h3><table class='table table-bordered table-striped mt-3'><thead class='table-dark'><tr><th>Type</th><th>Product</th><th>Quantity</th><th>Source</th><th>Destination</th><th>Status</th></tr></thead><tbody><% operations.forEach(op => { %><tr><td><%= op.type %></td><td><%= op.product ? op.product.name : 'N/A' %></td><td><%= op.quantity %></td><td><%= op.sourceLocation || 'N/A' %></td><td><%= op.destinationLocation || 'N/A' %></td><td><span class='badge bg-success'><%= op.status %></span></td></tr><% }) %></tbody></table><%- include('partials/footer') %></body></html>