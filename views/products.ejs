<!DOCTYPE html><html><head><title>StockSense - Products</title><link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'></head><body><%- include('partials/header') %><h2>Product Management</h2><form action='/inventory/products/add' method='POST' class='card p-3 my-3'><div class='row g-2'><div class='col-md-2'><input name='name' class='form-control' placeholder='Name' required></div><div class='col-md-2'><input name='sku' class='form-control' placeholder='SKU / Code' required></div><div class='col-md-2'><input name='category' class='form-control' placeholder='Category' required></div><div class='col-md-2'><input name='uom' class='form-control' placeholder='Unit (e.g. kg, units)' required></div><div class='col-md-2'><input name='quantity' type='number' class='form-control' placeholder='Initial Qty' required></div><div class='col-md-2'><button class='btn btn-success w-100' type='submit'>Add Product</button></div></div></form><table class='table table-bordered'><thead class='table-dark'><tr><th>Name</th><th>SKU</th><th>Category</th><th>UoM</th><th>Stock Qty</th><th>Location</th></tr></thead><tbody><% products.forEach(p => { %><tr><td><%= p.name %></td><td><%= p.sku %></td><td><%= p.category %></td><td><%= p.uom %></td><td><%= p.quantity %></td><td><%= p.location %></td></tr><% }) %></tbody></table><%- include('partials/footer') %></body></html>