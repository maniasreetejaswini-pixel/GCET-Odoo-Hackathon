<!DOCTYPE html> 
<html><head><title>StockSense - Products</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"></head> 
<body class="container py-4"> 
  <h1>Product Management</h1> 
  <a href="/inventory/dashboard" class="btn btn-secondary mb-3">Back to Dashboard</a> 
  <form action="/inventory/products/add" method="POST" class="row g-2 mb-4"> 
    <div class="col"><input name="name" class="form-control" placeholder="Product Name" required></div> 
    <div class="col"><input name="sku" class="form-control" placeholder="SKU" required></div> 
    <div class="col"><input name="category" class="form-control" placeholder="Category" required></div> 
    <div class="col"><input name="quantity" type="number" class="form-control" placeholder="Initial Qty" required></div> 
    <div class="col"><button class="btn btn-success" type="submit">Add Product</button></div> 
  </form> 
  <table class="table table-striped"><thead><tr><th>Name</th><th>SKU</th><th>Category</th><th>Stock Qty</th><th>Location</th></tr></thead><tbody> 
    <% products.forEach(p => { %> 
      <tr><td><%= p.name %></td><td><%= p.sku %></td><td><%= p.category %></td><td><%= p.quantity %></td><td><%= p.location %></td></tr> 
    <% }) %> 
  </tbody></table> 
</body></html> 
